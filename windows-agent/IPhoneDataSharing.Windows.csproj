<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>iPhone Data Sharing</AssemblyName>
    <RootNamespace>IPhoneDataSharing.Windows</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\AppIcon.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <Product>iPhone Data Sharing</Product>
    <Description>Local iPhone and Windows file sharing</Description>
    <Company>iPhone Data Sharing</Company>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>
</Project>
