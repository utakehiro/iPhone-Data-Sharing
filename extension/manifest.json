{
  "manifest_version": 3,
  "name": "iPhone Share",
  "version": "0.1.2",
  "description": "iPhoneからWindowsへ写真やファイルを送信するLAN内プロトタイプ",
  "permissions": ["storage", "downloads", "notifications", "alarms"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "iPhone Share",
    "default_popup": "popup.html"
  }
}
