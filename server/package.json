{
  "name": "iphone-windows-share-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "agent": "node dist/local-agent.js",
    "agent:dev": "tsx src/local-agent.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test:integration": "node test/integration.mjs",
    "test:shortcuts": "python3 ../tools/test_build_shortcuts.py",
    "test:agent": "npm run build && npm run test:shortcuts && node test/local-agent.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.4.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
